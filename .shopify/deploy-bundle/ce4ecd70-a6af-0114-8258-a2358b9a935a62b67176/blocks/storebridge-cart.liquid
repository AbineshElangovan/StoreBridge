{%- if request.page_type == 'cart' -%}
  {{ 'availability.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'availability.js' | asset_url }}?v={{ 'now' | date: '%s' }}" defer></script>

  <div
    id="storebridge-cart-embed"
    data-storebridge-cart="true"
    data-shop="{{ shop.permanent_domain }}"
    data-api-url="{{ block.settings.api_url | default: 'https://version-control.d38r9lc5j1o8oj.amplifyapp.com' }}"
    style="display: none;"
  ></div>
{%- endif -%}

{% schema %}
{
  "name": "StoreOrbit Cart",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "api_url",
      "label": "StoreOrbit App URL",
      "default": "https://version-control.d38r9lc5j1o8oj.amplifyapp.com"
    }
  ]
}
{% endschema %}
