generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// CORE INFRASTRUCTURE
// -----------------------------------------------------------------------------

model Store {
  id                       String  @id @default(uuid())
  uniqueStoreId            String  @unique @default(uuid())
  shopDomain               String  @unique
  shopifyStoreId           String?
  accessToken              String
  refreshToken             String?
  expiresAt                DateTime?
  refreshTokenExpiresAt    DateTime?
  scope                    String
  label                    String?
  masterLabel              String? @unique
  logoUrl                  String? @db.Text
  isActive                 Boolean @default(true)
  lowStockThreshold        Int     @default(10)
  bestSellerThreshold      Int
  deadStockDays            Int
  forecastPeriodDays       Int     @default(7)
  salesHistoryPeriodDays   Int     @default(30)
  supplierLeadTimeDays     Int     @default(7)
  safetyStockDays          Int     @default(3)
  autoSyncEnabled          Boolean @default(true)
  priceAdjustmentValue     Int     @default(0)
  priceAdjustmentType      String  @default("PERCENTAGE")
  isPriceAdjustmentEnabled Boolean @default(false)
  isMaster                 Boolean @default(false)

  authStatus        AuthStatus @default(AUTHENTICATED)
  lastAuthFailure   DateTime?
  authFailureReason String?
  tokenVersion      Int        @default(1)

  createdAt   DateTime @default(now())
  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variantMaps                VariantMap[]
  productCaches              ProductCache[]
  collections                Collection[]
  collectionPriceAdjustments CollectionPriceAdjustment[]
  collectionSkuRules         CollectionSkuRule[]
  sourceLogs                 SyncLog[]                   @relation("SourceStore")
  destLogs                   SyncLog[]                   @relation("DestinationStore")
  sourceConnections          StoreConnection[]           @relation("SourceConnections")
  targetConnections          StoreConnection[]           @relation("TargetConnections")
  storeSettings              StoreSetting?
  productMappings            ProductMapping[]
  productBaseSkus            ProductBaseSku[]
  variantBaseSkus            VariantBaseSku[]
  activityLogs               ActivityLog[]
  importHistories            ImportHistory[]
  notifications              Notification[]
  preorderConfigs            PreorderConfig[]
  notifyMeSettings           NotifyMeSetting?
  notifyMeRegistrations      NotifyMeRegistration[]
  notificationJobs           NotificationJob[]
  preorderRecords            PreorderRecord[]

  @@map("stores")
}

model StoreConnection {
  id            String   @id @default(uuid())
  sourceStoreId String
  targetStoreId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  sourceStore Store @relation("SourceConnections", fields: [sourceStoreId], references: [id], onDelete: Cascade)
  targetStore Store @relation("TargetConnections", fields: [targetStoreId], references: [id], onDelete: Cascade)

  @@unique([sourceStoreId, targetStoreId])
  @@map("store_connections")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  refreshToken        String?
  refreshTokenExpires DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@map("session")
}

// -----------------------------------------------------------------------------
// PRODUCT CACHING & MAPPING
// -----------------------------------------------------------------------------

model VariantMap {
  id               String   @id @default(uuid())
  sku              String
  storeId          String
  shopifyProductId String
  shopifyVariantId String?
  inventoryItemId  String?
  locationId       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, shopifyVariantId])
  @@index([sku])
  @@map("variant_maps")
}

model ProductCache {
  id                String   @id @default(uuid())
  storeId           String
  shopifyProductId  String
  shopifyVariantId  String
  sku               String?
  title             String
  tags              String?
  imageUrl          String?
  price             Float    @default(0.0)
  basePrice         Float    @default(0.0)
  inventoryQuantity Int      @default(0)
  optionsJson       Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  store       Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  collections CollectionProduct[]

  @@unique([storeId, shopifyVariantId])
  @@index([sku])
  @@map("product_cache")
}

// -----------------------------------------------------------------------------
// LOGGING & WEBHOOK EVENTS
// -----------------------------------------------------------------------------

model SyncLog {
  id                 String    @id @default(uuid())
  sku                String?
  sourceStoreId      String
  destinationStoreId String
  previousQuantity   Int       @default(0)
  updatedQuantity    Int       @default(0)
  status             String
  failureReason      String?   @db.Text
  triggerType        String    @default("WEBHOOK")
  webhookEventId     String?
  syncType           String    @default("UNKNOWN")
  webhookTopic       String?
  retryCount         Int       @default(0)
  nextRetryAt        DateTime?
  errorCode          String?
  errorMessage       String?   @db.Text
  requestId          String?
  durationMs         Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  sourceStore      Store @relation("SourceStore", fields: [sourceStoreId], references: [id])
  destinationStore Store @relation("DestinationStore", fields: [destinationStoreId], references: [id])

  @@unique([webhookEventId, syncType, destinationStoreId])
  @@index([sku])
  @@index([status])
  @@index([createdAt])
  @@map("sync_logs")
}

model WebhookEvent {
  id          String   @id
  topic       String
  shopDomain  String
  processedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([shopDomain, topic])
  @@map("webhook_events")
}

// -----------------------------------------------------------------------------
// COLLECTIONS
// -----------------------------------------------------------------------------

enum CollectionSource {
  SHOPIFY
}

model Collection {
  id                  String           @id @default(uuid())
  storeId             String
  shopifyCollectionId String
  title               String
  handle              String
  source              CollectionSource @default(SHOPIFY)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  store            Store                       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products         CollectionProduct[]
  priceAdjustments CollectionPriceAdjustment[]
  skuRules         CollectionSkuRule[]

  @@unique([storeId, shopifyCollectionId])
  @@map("collections")
}

model CollectionProduct {
  id             String @id @default(uuid())
  collectionId   String
  productCacheId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  collection   Collection   @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productCache ProductCache @relation(fields: [productCacheId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productCacheId])
  @@map("collection_products")
}

// -----------------------------------------------------------------------------
// STORE CONFIGURATION
// -----------------------------------------------------------------------------

model StoreSetting {
  id                     String   @id @default(uuid())
  storeId                String   @unique
  skuPrefix              String   @default("SKU")
  skuSequence            Int      @default(1)
  isSkuGenerationEnabled Boolean  @default(true)
  dataRetentionEnabled   Boolean  @default(true)
  notifyLowStock         Boolean  @default(true)
  notifyInventoryUpdate  Boolean  @default(true)
  notifyPriceUpdate      Boolean  @default(true)
  notifySyncUpdate       Boolean  @default(true)
  notifySyncFailure      Boolean  @default(true)
  notifyStoreUpdate      Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_settings")
}

// -----------------------------------------------------------------------------
// SKU GENERATION & TRACKING
// -----------------------------------------------------------------------------

model ProductMapping {
  id               String   @id @default(cuid())
  productUniqueId  String
  storeId          String
  storeName        String?
  shopifyProductId String
  shopifyVariantId String
  inventoryItemId  String?
  sku              String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, shopifyVariantId])
  @@index([productUniqueId])
  @@map("product_mappings")
}

model ProductUniqueIdSequence {
  id              String   @id @default("product")
  currentSequence Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@map("product_unique_id_sequence")
}

model ProductBaseSku {
  id               String   @id @default(uuid())
  shopifyProductId String
  storeId          String
  baseSequence     Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, shopifyProductId])
  @@map("product_base_skus")
}

model VariantBaseSku {
  id               String   @id @default(uuid())
  shopifyVariantId String
  storeId          String
  baseSequence     Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, shopifyVariantId])
  @@map("variant_base_skus")
}

// -----------------------------------------------------------------------------
// SYSTEM QUEUES & AUDITS
// -----------------------------------------------------------------------------

enum WebhookStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AuthStatus {
  AUTHENTICATED
  REQUIRES_REAUTH
  INVALID_TOKEN
  UNINSTALLED
  PENDING
  SUSPENDED
}

model WebhookQueue {
  id         String        @id @default(uuid())
  webhookId  String        @unique // From X-Shopify-Webhook-Id to prevent duplicates
  eventId    String?       // From X-Shopify-Event-Id for event correlation
  topic      String
  shopDomain String
  apiVersion String?
  payload    Json
  status     WebhookStatus @default(PENDING)
  attempts   Int           @default(0)
  error      String?       @db.Text
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([shopDomain, topic])
  @@index([eventId])
  @@map("webhook_queue")
}

model AuthAudit {
  id         String   @id @default(cuid())
  shopDomain String
  event      String
  success    Boolean
  message    String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([shopDomain])
  @@index([createdAt])
  @@map("auth_audits")
}

model DeadLetterQueue {
  id             String   @id @default(cuid())
  storeId        String
  jobType        String // e.g. "webhook", "sync"
  payload        Json
  error          String?  @db.Text
  failedAttempts Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([storeId])
  @@map("dead_letter_queue")
}

// -----------------------------------------------------------------------------
// COLLECTION RULES & PRICING
// -----------------------------------------------------------------------------

enum PriceAdjustmentType {
  PERCENTAGE
  FIXED
}

model CollectionPriceAdjustment {
  id              String              @id @default(uuid())
  storeId         String
  collectionId    String
  enabled         Boolean             @default(false)
  adjustmentType  PriceAdjustmentType @default(PERCENTAGE)
  adjustmentValue Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  store      Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([storeId, collectionId])
  @@map("collection_price_adjustments")
}

model CollectionSkuRule {
  id              String   @id @default(uuid())
  storeId         String
  collectionId    String
  enabled         Boolean  @default(false)
  skuPrefix       String   @default("")
  startSequence   Int      @default(1)
  currentSequence Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  store      Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([storeId, collectionId])
  @@map("collection_sku_rules")
}

// -----------------------------------------------------------------------------
// ACTIVITY LOGGING
// -----------------------------------------------------------------------------

enum ActivityEventType {
  CREATE
  UPDATE
  DELETE
  SOLD
}

model ActivityLog {
  id           String            @id @default(uuid())
  storeId      String
  productId    String?
  productTitle String
  sku          String?
  imageUrl     String?
  eventType    ActivityEventType
  description  String
  quantity     Int?
  amount       Float?
  collection   String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([storeId, createdAt])
  @@index([sku])
  @@index([productTitle])
  @@index([createdAt])
  @@map("activity_logs")
}

// -----------------------------------------------------------------------------
// IMPORT HISTORY
// -----------------------------------------------------------------------------

model ImportHistory {
  id             String   @id @default(uuid())
  storeId        String
  filename       String
  totalProducts  Int
  successCount   Int
  failedCount    Int
  skippedCount   Int
  status         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([createdAt])
  @@map("import_history")
}

// -----------------------------------------------------------------------------
// NOTIFICATION SYSTEM
// -----------------------------------------------------------------------------

enum NotificationType {
  LOW_STOCK
  OUT_OF_STOCK
  STOCKOUT_RISK
  CONNECTED_STORE_UPDATE
  INVENTORY_UPDATE
  PRICE_UPDATE
  SYNC_UPDATE
  SYNC_FAILURE
  PRODUCT_UPDATED
  IMPORT_COMPLETED
}

model Notification {
  id               String           @id @default(uuid())
  recipientStoreId String
  type             NotificationType
  title            String
  message          String
  productId        String?
  productTitle     String?
  sourceStoreId    String?
  targetStoreId    String?
  isRead           Boolean          @default(false)
  metadata         Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  recipientStore Store @relation(fields: [recipientStoreId], references: [id], onDelete: Cascade)

  @@index([recipientStoreId])
  @@index([recipientStoreId, isRead])
  @@index([recipientStoreId, createdAt])
  @@map("notifications")
}

// -----------------------------------------------------------------------------
// CUSTOMER EXPERIENCE: PRE-ORDER, NOTIFY ME, BACK IN STOCK
// -----------------------------------------------------------------------------

model PreorderConfig {
  id                 String   @id @default(uuid())
  storeId            String
  shopifyProductId   String?
  shopifyVariantId   String?
  enabled            Boolean  @default(true)
  inventoryThreshold Int      @default(0)
  maxQuantity        Int?
  customerMessage    String   @default("Pre-order before it's gone.")
  shippingMessage    String   @default("Shipping: As soon as possible")
  fulfillmentMessage String   @default("We will fulfill the item as soon as it becomes available")
  discountType       String   @default("none")
  discountValue      Float    @default(0)
  selectionMode      String   @default("ALL_PRODUCTS")
  selectedProductIds String[] @default([])
  selectedCollectionIds String[] @default([])
  allowHalfPayment   Boolean  @default(true)
  allowFullPayment   Boolean  @default(true)
  defaultPaymentOption String @default("HALF")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, shopifyProductId, shopifyVariantId])
  @@index([storeId])
  @@index([shopifyProductId])
  @@index([shopifyVariantId])
  @@map("preorder_configs")
}

model NotifyMeSetting {
  id             String   @id @default(uuid())
  storeId        String   @unique
  enabled        Boolean  @default(true)
  notifyEmail    Boolean  @default(true)
  notifyWhatsApp Boolean  @default(true)
  popupMessage   String   @default("Get notified when this item is back in stock.")
  buttonText     String   @default("Notify me")
  successMessage String   @default("You're on the list!")
  emailSubject   String?  @default("Good news! {{product_title}} is back in stock")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("notify_me_settings")
}

enum NotifyMeStatus {
  PENDING
  NOTIFIED
  CANCELLED
}

model NotifyMeRegistration {
  id               String         @id @default(uuid())
  storeId          String
  shopifyProductId String
  shopifyVariantId String
  customerEmail    String?
  customerWhatsApp String?
  requestedQuantity Int           @default(1)
  notifyByEmail    Boolean        @default(true)
  notifyByWhatsApp Boolean        @default(false)
  status           NotifyMeStatus @default(PENDING)
  notifiedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  store            Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  notificationJobs NotificationJob[]

  @@index([storeId])
  @@index([shopifyProductId])
  @@index([shopifyVariantId])
  @@index([status])
  @@index([storeId, shopifyVariantId, customerEmail])
  @@map("notify_me_registrations")
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum NotificationJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model NotificationJob {
  id               String                @id @default(uuid())
  registrationId   String?
  storeId          String
  shopifyVariantId String
  customerEmail    String?
  customerWhatsApp String?
  channel          NotificationChannel
  productTitle     String
  variantTitle     String?
  imageUrl         String?
  productUrl       String?
  status           NotificationJobStatus @default(PENDING)
  attempts         Int                   @default(0)
  maxAttempts      Int                   @default(3)
  lastError        String?               @db.Text
  sentAt           DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  store        Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  registration NotifyMeRegistration? @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([registrationId])
  @@index([status])
  @@index([shopifyVariantId])
  @@map("notification_jobs")
}

model PreorderRecord {
  id               String    @id @default(uuid())
  storeId          String
  shopifyOrderId   String
  orderNumber      String
  shopifyVariantId String
  customerName     String?   // Encrypted AES-256-GCM
  customerEmail    String?   // Encrypted AES-256-GCM
  customerPhone    String?   // Encrypted AES-256-GCM
  quantity         Int       @default(1)
  whatsappOptIn    Boolean   @default(false)
  status           String    @default("UNFULFILLED")
  notifiedAt       DateTime?
  productTitle     String?
  variantTitle     String?
  paymentOption    String    @default("FULL")
  totalAmount      Float     @default(0)
  depositAmount    Float     @default(0)
  remainingBalance Float     @default(0)
  paymentStatus    String    @default("PENDING")
  paymentLink      String?
  finalPaymentDate DateTime?
  currency         String    @default("INR")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, shopifyOrderId, shopifyVariantId])
  @@index([storeId])
  @@index([shopifyVariantId])
  @@index([status])
  @@index([paymentStatus])
  @@index([paymentOption])
  @@map("preorder_records")
}

