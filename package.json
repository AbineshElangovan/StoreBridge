{
  "name": "shopify-sync",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "powershell -ExecutionPolicy Bypass -File ./scripts/clean-ports.ps1",
    "preshopify:dev": "powershell -ExecutionPolicy Bypass -File ./scripts/clean-ports.ps1",
    "dev": "concurrently -n tunnel,storebridge -c cyan,green --restart-tries -1 --restart-after 3000 \"npm run tunnel\" \"npm run next:dev\"",
    "tunnel": "devtunnel host interesting-mountain-116tjtx.inc1",
    "shopify:dev": "shopify app dev --tunnel-url https://dz50mdfc-3000.inc1.devtunnels.ms:3000 --no-update",
    "shopify:all": "concurrently -n tunnel,shopify -c cyan,green --restart-tries -1 --restart-after 3000 \"npm run tunnel\" \"npm run shopify:dev\"",
    "next:dev": "next dev --webpack -p 3000",
    "build": "next build",
    "start": "next start",
    "prisma:studio": "prisma studio",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prepare": "husky"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@shopify/app-bridge": "^3.7.11",
    "@shopify/app-bridge-react": "^3.7.11",
    "@shopify/polaris": "^13.9.5",
    "@shopify/polaris-icons": "^9.3.1",
    "@shopify/shopify-api": "^13.1.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "libphonenumber-js": "^1.13.14",
    "localtunnel": "^2.0.2",
    "next": "16.2.9",
    "nodemailer": "^10.0.15",
    "prisma": "^6.19.0",
    "puppeteer-core": "^25.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.9.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "papaparse": "^5.6.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
